async function emitirNFe() {
    const valido = await validarCertificadoAntesDeEmitir();
    if (valido) {
        console.log("✅ Certificado validado! Nota emitida com sucesso.");
        alert("✅ Nota Fiscal emitida com sucesso!");
    } else {
        alert("❌ Falha na emissão: Certificado inválido ou servidor offline.");
    }
}
