                          </thead>
                          <tbody>
                            {nota.items.map(function(item, index) {
                              return (
                                <tr key={item.id || index} className="border-b border-slate-800/50">
                                  <td className="py-3 text-white">{item.descricao}</td>
                                  <td className="py-3 text-white">{item.codigo}</td>
                                  <td className="py-3 text-white">{item.unidade}</td>
                                  <td className="py-3 text-right text-white">{item.quantidade?.toFixed(2)}</td>
                                  <td className="py-3 text-right text-white">{formatCurrency(item.preco_unitario)}</td>
                                  <td className="py-3 text-right text-white">{formatCurrency(item.preco_total)}</td>
                                  <td className="py-3 text-white font-mono text-orange-300">{FIXOS.ncm}</td>
                                </tr>
                              );
                            })}
                          </tbody>
                        </table>
                      </div>
                    </div>

                    {/* Cálculo de Imposto */}
                    <div className="rounded-xl border border-slate-800 bg-slate-950/50 p-4">
                      <h3 className="mb-3 text-sm font-semibold text-orange-400">Cálculo de Imposto</h3>
                      <div className="grid grid-cols-2 gap-4 md:grid-cols-3">
                        <div>
                          <p className="text-xs text-slate-500">Total dos Produtos</p>
                          <p className="text-sm text-white">{formatCurrency(nota.calculo_imposto.total_produtos)}</p>
                        </div>
                        <div>
                          <p className="text-xs text-slate-500">Valor do Frete</p>
                          <p className="text-sm text-white">{formatCurrency(nota.calculo_imposto.valor_frete)}</p>
                        </div>
                        <div>
                          <p className="text-xs text-slate-500">Valor do Seguro</p>
                          <p className="text-sm text-white">{formatCurrency(nota.calculo_imposto.valor_seguro)}</p>
                        </div>
                        <div>
                          <p className="text-xs text-slate-500">Outras Despesas</p>
                          <p className="text-sm text-white">{formatCurrency(nota.calculo_imposto.outras_despesas)}</p>
                        </div>
                        <div>
                          <p className="text-xs text-slate-500">Desconto</p>
                          <p className="text-sm text-white text-rose-400">{formatCurrency(nota.calculo_imposto.desconto)}</p>
                        </div>
                        <div>
                          <p className="text-xs text-slate-500">Total da Nota</p>
                          <p className="text-lg font-bold text-orange-400">{formatCurrency(nota.calculo_imposto.total_nota)}</p>
                        </div>
                      </div>
                    </div>

                    {/* Transportador */}
                    <div className="rounded-xl border border-slate-800 bg-slate-950/50 p-4">
                      <h3 className="mb-3 text-sm font-semibold text-orange-400">Transportador</h3>
                      <div className="grid grid-cols-2 gap-4 md:grid-cols-4">
                        <div className="col-span-2">
                          <p className="text-xs text-slate-500">Logística</p>
                          <p className="text-sm text-white">{nota.transportador.logistica}</p>
                        </div>
                        <div className="col-span-2">
                          <p className="text-xs text-slate-500">Frete por Conta</p>
                          <p className="text-sm text-white">{nota.transportador.frete_por_conta}</p>
                        </div>
                      </div>
                      <div className="mt-3 overflow-x-auto">
                        <table className="w-full text-sm">
                          <thead>
                            <tr className="border-b border-slate-800 text-left text-xs text-slate-500">
                              <th className="pb-2">Vol.</th>
                              <th className="pb-2">Serviço</th>
                              <th className="pb-2">Tracking</th>
                            </tr>
                          </thead>
                          <tbody>
                            {nota.transportador.objetos.map(function(obj, index) {
                              return (
                                <tr key={index} className="border-b border-slate-800/50">
                                  <td className="py-2 text-white">{obj.volume}</td>
                                  <td className="py-2 text-white">{obj.servico}</td>
                                  <td className="py-2 text-white font-mono">{obj.tracking}</td>
                                </tr>
                              );
                            })}
                          </tbody>
                        </table>
                      </div>
                    </div>

                    {/* Endereço de Entrega */}
                    <div className="rounded-xl border border-slate-800 bg-slate-950/50 p-4">
                      <h3 className="mb-3 text-sm font-semibold text-orange-400">Endereço de Entrega</h3>
                      <div className="grid grid-cols-2 gap-4 md:grid-cols-4">
                        <div className="col-span-2">
                          <p className="text-xs text-slate-500">Nome</p>
                          <p className="text-sm text-white">{nota.endereco_entrega.nome}</p>
                        </div>
                        <div>
                          <p className="text-xs text-slate-500">CEP</p>
                          <p className="text-sm text-white font-mono">{nota.endereco_entrega.cep}</p>
                        </div>
                        <div>
                          <p className="text-xs text-slate-500">UF</p>
                          <p className="text-sm text-white">{nota.endereco_entrega.uf}</p>
                        </div>
                        <div>
                          <p className="text-xs text-slate-500">Município</p>
                          <p className="text-sm text-white">{nota.endereco_entrega.municipio}</p>
                        </div>
                        <div>
                          <p className="text-xs text-slate-500">Bairro</p>
                          <p className="text-sm text-white">{nota.endereco_entrega.bairro}</p>
                        </div>
                        <div className="col-span-2">
                          <p className="text-xs text-slate-500">Endereço</p>
                          <p className="text-sm text-white">
                            {nota.endereco_entrega.endereco}, {nota.endereco_entrega.numero}
                            {nota.endereco_entrega.complemento ? ' - ' + nota.endereco_entrega.complemento : ''}
                          </p>
                        </div>
                      </div>
                    </div>

                    {/* Pagamento */}
                    <div className="rounded-xl border border-slate-800 bg-slate-950/50 p-4">
                      <h3 className="mb-3 text-sm font-semibold text-orange-400">Pagamento</h3>
                      <div className="grid grid-cols-2 gap-4 md:grid-cols-4">
                        <div>
                          <p className="text-xs text-slate-500">Condição</p>
                          <p className="text-sm text-white">{nota.pagamento.condicao} dias</p>
                        </div>
                        <div>
                          <p className="text-xs text-slate-500">Data</p>
                          <p className="text-sm text-white">{nota.pagamento.data}</p>
                        </div>
                        <div>
                          <p className="text-xs text-slate-500">Valor</p>
                          <p className="text-sm text-white font-semibold">{formatCurrency(nota.pagamento.valor)}</p>
                        </div>
                        <div>
                          <p className="text-xs text-slate-500">Forma</p>
                          <p className="text-sm text-white uppercase">{nota.pagamento.forma}</p>
                        </div>
                      </div>
                    </div>

                    {/* Valores Fixos */}
                    <div className="rounded-xl border border-orange-500/30 bg-orange-500/5 p-4">
                      <h3 className="mb-3 text-sm font-semibold text-orange-400">Valores Fiscais Fixos</h3>
                      <div className="grid grid-cols-2 gap-4 md:grid-cols-5">
                        <div className="rounded-lg bg-slate-950/70 p-3">
                          <p className="text-xs text-slate-500">CEST</p>
                          <p className="text-sm font-mono font-bold text-orange-300">{FIXOS.cest}</p>
                        </div>
                        <div className="rounded-lg bg-slate-950/70 p-3">
                          <p className="text-xs text-slate-500">NCM</p>
                          <p className="text-sm font-mono font-bold text-orange-300">{FIXOS.ncm}</p>
                        </div>
                        <div className="rounded-lg bg-slate-950/70 p-3">
                          <p className="text-xs text-slate-500">Origem</p>
                          <p className="text-sm font-mono text-white">{FIXOS.origem}</p>
                        </div>
                        <div className="rounded-lg bg-slate-950/70 p-3">
                          <p className="text-xs text-slate-500">CSOSN</p>
                          <p className="text-sm font-mono text-white">{FIXOS.csosn}</p>
                        </div>
                        <div className="rounded-lg bg-slate-950/70 p-3">
                          <p className="text-xs text-slate-500">CFOP</p>
                          <p className="text-sm font-mono text-white">{FIXOS.cfop}</p>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            );
          })
        )}
      </div>

      {/* Componente de Impressão (oculto) */}
      {printNota && <PrintContent nota={printNota} />}
    </div>
  );
}
