import express from 'express';
import cors from 'cors';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = 3001;

// Middleware
app.use(cors());
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

// Log de requisições
app.use((req, res, next) => {
    console.log(\ - \ \);
    next();
});

// ============================================
// ARMAZENAMENTO LOCAL
// ============================================
const DATA_DIR = path.join(__dirname, 'data');
const COMPANIES_FILE = path.join(DATA_DIR, 'companies.json');

if (!fs.existsSync(DATA_DIR)) {
    fs.mkdirSync(DATA_DIR, { recursive: true });
}

if (!fs.existsSync(COMPANIES_FILE)) {
    fs.writeFileSync(COMPANIES_FILE, JSON.stringify([], null, 2));
}

function getCompanies() {
    try {
        const data = fs.readFileSync(COMPANIES_FILE, 'utf8');
        return JSON.parse(data);
    } catch {
        return [];
    }
}

function saveCompanies(companies) {
    fs.writeFileSync(COMPANIES_FILE, JSON.stringify(companies, null, 2));
}

// ============================================
// ROTAS DA API
// ============================================

// Rota raiz
app.get('/', (req, res) => {
    res.json({
        name: 'ERP Metal Racing API',
        version: '1.0.0',
        status: 'online',
        endpoints: [
            'GET  /api/empresas',
            'POST /api/empresas',
            'PUT  /api/empresas/:id',
            'DELETE /api/empresas/:id',
            'POST /api/empresas/sefaz/testar'
        ]
    });
});

// LISTAR empresas (GET)
app.get('/api/empresas', (req, res) => {
    try {
        console.log('📋 Listando empresas...');
        const companies = getCompanies();
        res.json(companies);
    } catch (error) {
        console.error('❌ Erro ao listar:', error.message);
        res.status(500).json({ error: error.message });
    }
});

// CRIAR empresa (POST)
app.post('/api/empresas', (req, res) => {
    try {
        console.log('📝 Criando empresa...');
        const companies = getCompanies();
        const newCompany = {
            id: Date.now(),
            ...req.body,
            status: 'ativo',
            created_at: new Date().toISOString(),
            updated_at: new Date().toISOString()
        };
        
        // Verificar duplicidade
        const exists = companies.some(c => c.cnpj === newCompany.cnpj);
        if (exists) {
            return res.status(400).json({ 
                error: 'CNPJ já cadastrado',
                cnpj: newCompany.cnpj
            });
        }
        
        companies.push(newCompany);
        saveCompanies(companies);
        
        console.log('✅ Empresa criada:', newCompany.razao_social);
        res.status(201).json({ 
            success: true, 
            data: newCompany,
            message: 'Empresa cadastrada com sucesso!'
        });
    } catch (error) {
        console.error('❌ Erro:', error.message);
        res.status(500).json({ error: error.message });
    }
});

// ATUALIZAR empresa (PUT)
app.put('/api/empresas/:id', (req, res) => {
    try {
        const companies = getCompanies();
        const id = parseInt(req.params.id);
        const index = companies.findIndex(c => c.id === id);
        
        if (index === -1) {
            return res.status(404).json({ error: 'Empresa não encontrada' });
        }
        
        companies[index] = {
            ...companies[index],
            ...req.body,
            updated_at: new Date().toISOString()
        };
        
        saveCompanies(companies);
        res.json({ 
            success: true, 
            data: companies[index],
            message: 'Empresa atualizada!'
        });
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
});

// DELETAR empresa (DELETE)
app.delete('/api/empresas/:id', (req, res) => {
    try {
        const companies = getCompanies();
        const id = parseInt(req.params.id);
        const filtered = companies.filter(c => c.id !== id);
        
        if (filtered.length === companies.length) {
            return res.status(404).json({ error: 'Empresa não encontrada' });
        }
        
        saveCompanies(filtered);
        res.json({ success: true, message: 'Empresa removida!' });
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
});

// Teste SEFAZ
app.post('/api/empresas/sefaz/testar', async (req, res) => {
    try {
        const { cnpj, uf, ambiente } = req.body;
        console.log('🧪 Teste SEFAZ:', { cnpj, uf, ambiente });
        
        res.json({
            success: true,
            cStat: '107',
            xMotivo: 'Autorizado o uso da NF-e (SIMULAÇÃO)',
            nProt: Date.now().toString().padStart(15, '0'),
            dhRecbto: new Date().toISOString(),
            message: 'Teste SEFAZ realizado com sucesso!'
        });
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
});

